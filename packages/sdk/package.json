{
  "name": "@memora/client",
  "version": "0.1.0",
  "description": "TypeScript client for the Memora memory API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "memory",
    "llm",
    "agents",
    "memora"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memora/memora.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
